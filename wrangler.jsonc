{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The PIC Events console on Cloudflare: the static export (out/) as static assets, plus a small
  // Worker that only runs for shared event links to fill in their link previews.
  // Build command: pnpm run build   Deploy command: npx wrangler deploy
  "name": "eventhub",
  "compatibility_date": "2026-09-26",
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // everything else is served straight from the files, without running the Worker
    "run_worker_first": ["/e/*"]
  },
  // keep NEXT_PUBLIC_API_URL and the other variables set in the Cloudflare dashboard
  "keep_vars": true,
  "workers_dev": true,
  "observability": { "enabled": true }
}
