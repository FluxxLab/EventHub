# The PIC Events API, with the version prefix. Required for a production build.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Demo mode: sample data and any sign-in, no API needed. Never set this on a deployed console.
# NEXT_PUBLIC_DEMO_MODE=true

# Live ops alerts (minutes). A session not live this long after its start, or still live this long
# after its end, is flagged on every console page. Defaults: 5 and 10.
# NEXT_PUBLIC_LATE_START_MIN=5
# NEXT_PUBLIC_OVERRUN_GRACE_MIN=10

# Public event page (/e/<id>, what the app's shared links open; see docs/public-event-page.md).
# This site's origin, for absolute link-preview URLs. Use the same value as the app's EXPO_PUBLIC_WEB_URL.
# NEXT_PUBLIC_SITE_URL=https://events.pic.org.ng
# Store listings; unset, the page says "coming soon".
# NEXT_PUBLIC_APP_STORE_URL=
# NEXT_PUBLIC_PLAY_STORE_URL=

# Public product site (/welcome): where "Request a demo" sends. Shown on the page too.
# NEXT_PUBLIC_SALES_EMAIL=
